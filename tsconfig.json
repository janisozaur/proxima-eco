{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "web", "types"]
}
